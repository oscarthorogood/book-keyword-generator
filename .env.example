# Signs the one-click approve/deny links emailed to you. Set this to a long
# random string in production — a predictable value lets anyone forge an
# approval link and grant themselves access. `openssl rand -base64 32`
AUTH_SECRET=

# Public origin of the deployment, used to build absolute links in emails.
# Falls back to the request origin when unset (fine for local dev).
NEXT_PUBLIC_SITE_URL=

# --- Auth (required) -------------------------------------------------------
# Sign-in is a magic link gated by an allowlist. A new email address is
# recorded as pending and you get an email with Approve / Deny buttons.

# Publishable key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend API key — sends the approval and sign-in emails. https://resend.com
RESEND_API_KEY=

# Verified sender, e.g. "Ads Builder <noreply@yourdomain.com>". Resend's
# onboarding@resend.dev works for testing but only delivers to your own address.
EMAIL_FROM=

# Where access requests are sent for approval.
ADMIN_EMAIL=

# Login with Amazon security profile registered in the Amazon Ads console.
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=

# Minted once via a manual Login with Amazon OAuth consent flow (not automated by this app).
AMAZON_ADS_REFRESH_TOKEN=

# The advertising profile ID for the marketplace account the ASIN belongs to.
AMAZON_ADS_PROFILE_ID=

# Optional. Google Books API works without a key; set one only if you hit throttling.
GOOGLE_BOOKS_API_KEY=

# Optional. Amazon blocks/CAPTCHAs product-page scrapes from cloud-hosted
# deployments (Vercel, AWS, etc.) — this routes just the product-page fetch
# (and the Goodreads lookup) through ScraperAPI's residential/rotating-IP
# proxy instead of hitting the target directly. Get a free-tier key
# (~1,000 requests/month) at https://www.scraperapi.com — leave unset for
# local dev, where a direct fetch from your home IP usually works fine anyway.
SCRAPER_PROXY_API_KEY=

# Optional. Alternative to SCRAPER_PROXY_API_KEY above — same purpose (routes
# the product-page fetch and the Goodreads lookup through a residential/
# rotating-IP proxy), backed by ScrapingBee instead of ScraperAPI. When both
# are set, ScrapingBee takes priority. Get a free-tier key (~1,000 API
# credits/month) at https://www.scrapingbee.com.
SCRAPINGBEE_API_KEY=

# Optional but recommended. SerpApi is the licensed way to read Amazon, and
# when set it powers three things: book creation reads the product page via
# the Amazon Product API (structured JSON from SerpApi's own infrastructure,
# so it avoids the CAPTCHA/bot-check wall above), a snowball crawl fills in
# comparable titles when the direct crawl comes back empty, and keyword
# generation pulls Amazon's own "related searches" plus search-bar
# autocomplete for the book's genre. Each call is one search credit; keyword
# generation is capped at 8 per run. Unset falls back to the direct scrape
# and the unofficial autocomplete endpoints. Get a key at https://serpapi.com.
SERPAPI_API_KEY=

# Optional. When set, keyword generation fetches Decodo's SERP Scraping API
# live for the same genre/comp seed terms SerpApi uses, instead of requiring
# a manually pasted Decodo CSV/JSON export. Manually supplied decodoRows in a
# generate request still take precedence over the live fetch. Get a key at
# https://decodo.com.
DECODO_API_KEY=

# Optional. Logs every outbound page fetch (URL, status, duration) rather
# than only the failures and bot checks. All fetches are recorded in the
# in-memory audit log either way (lib/fetchLog.ts) — this just makes the
# routine ones visible in the server output while debugging a scrape.
DEBUG_FETCH_LOG=

# Optional. Powers the final AI ranking pass over the keyword shortlist
# (lib/aiRanker.ts) — without it, the app falls back to the heuristic
# scorer alone (still a complete ranking, just not AI-judged). Get a free
# key (no credit card, generous daily limits) at https://aistudio.google.com.
GEMINI_API_KEY=

# Strongly recommended — the most reliable way to read an Amazon book page.
# When set, adding a book reads the product page through Firecrawl's rendered
# structured extraction (title, author, series, categories, best-seller ranks,
# comparable titles, review snippets, Q&A) alongside the direct scrape, and
# keeps working when Amazon bot-checks the direct request — which is the usual
# outcome from a cloud deployment. Also feeds the AI ranking pass a markdown
# excerpt of the page. Get a key at https://www.firecrawl.dev.
FIRECRAWL_API_KEY=

# Archives every generated bulksheet to a private Supabase Storage
# bucket ("bulksheets") and returns a 1-hour signed download link alongside
# the direct download. Also backs authentication, so these are now required.
# Project URL: Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=

# SERVER ONLY — bypasses row-level security. Never prefix with NEXT_PUBLIC_
# and never reference it from a Client Component.
SUPABASE_SERVICE_ROLE_KEY=
