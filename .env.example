# Password for login (required for access to the app).
APP_PASSWORD=

# Secret key for JWT token signing (auto-generated, but recommended to set in production).
# If not set, defaults to a development key.
AUTH_SECRET=

# Login with Amazon security profile registered in the Amazon Ads console.
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=

# Minted once via a manual Login with Amazon OAuth consent flow (not automated by this app).
AMAZON_ADS_REFRESH_TOKEN=

# The advertising profile ID for the marketplace account the ASIN belongs to.
AMAZON_ADS_PROFILE_ID=

# Optional. Google Books API works without a key; set one only if you hit throttling.
GOOGLE_BOOKS_API_KEY=

# Optional. Amazon blocks/CAPTCHAs product-page scrapes from cloud-hosted
# deployments (Vercel, AWS, etc.) — this routes just the product-page fetch
# (and the Goodreads lookup) through ScraperAPI's residential/rotating-IP
# proxy instead of hitting the target directly. Get a free-tier key
# (~1,000 requests/month) at https://www.scraperapi.com — leave unset for
# local dev, where a direct fetch from your home IP usually works fine anyway.
SCRAPER_PROXY_API_KEY=

# Optional. Powers the final AI ranking pass over the keyword shortlist
# (lib/aiRanker.ts) — without it, the app falls back to the heuristic
# scorer alone (still a complete ranking, just not AI-judged). Get a free
# key (no credit card, generous daily limits) at https://aistudio.google.com.
GEMINI_API_KEY=

# Optional. Feeds the AI ranking pass richer natural-language context — a
# clean markdown scrape of the book's own product page (lib/firecrawl.ts).
# Only used when GEMINI_API_KEY is also set; has no effect on its own. Get a
# key at https://www.firecrawl.dev (check their current free-tier credits).
FIRECRAWL_API_KEY=
